---
import Dashboard from "../../../components/Dashboard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getMessages } from "../../../i18n/messages";

export function getStaticPaths() {
  return ["NLD", "DEU", "BEL"].map((country) => ({ params: { country }, props: { country } }));
}

const { country } = Astro.props;
const copy = getMessages("en");
---

<BaseLayout locale="en" title={copy.brand} description={copy.intro}>
  <Dashboard locale="en" initialCountry={country} />
</BaseLayout>
