      "report_sha256": "02c11e1987006aea9f8780a15838abde4a4c17cbcdf36751444010d80cfab2a8"
    },
    {
      "requirement_id": "Q07",
      "assessment": "Chosen PISA SES retained; no added official ESCS robustness. Home-SES appendix has one usable released wave per study and no spliced historical scale or trend claim.",
