      "report_sha256": "355a54207b97d823628f8d299e5fb78eaa43258f17b792af4c7412ac3db21cfa"
    },
    {
      "requirement_id": "Q02",
      "assessment": "Official population, response, exclusions, mode and cycle qualifications reviewed for every used context. Documented unreported percentages remain unknown. AUT2009/ESP2018 trend qualifications, CAN2001 regional population and POL early grade-3 to grade-4 changes exclude comparable support without deleting historical targets.",
      "applicability": "APPLICABLE_REVIEWED_WITH_QUALIFICATIONS",
      "report_sha256": "586fb54de717129cc7a977cbbebc06338623d7e30186cc40161a27c9420ebf8d"
    },
    {
      "requirement_id": "Q03",
